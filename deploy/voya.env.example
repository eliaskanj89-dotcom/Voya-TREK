# Voya production environment
# Copy to .env.production and keep that file out of Git.

# Public URL for the deployed Voya instance.
APP_URL=https://voya.example.com
ALLOWED_ORIGINS=https://voya.example.com

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Initial admin credentials are only used on a fresh database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

TZ=UTC
LOG_LEVEL=info
VOYA_PORT=3000

# Keep HTTPS/cookies hardened behind a TLS proxy.
FORCE_HTTPS=true
COOKIE_SECURE=true
TRUST_PROXY=1

# Voya AI provider credentials are stored encrypted through Admin/Settings.
# This timeout applies to configured LLM providers.
LLM_TIMEOUT_MS=900000

# Optional destination/place imagery.
UNSPLASH_ACCESS_KEY=

# TREK provider-backed place search remains available to Voya.
TREK_PLACES_ENABLED=true
TREK_PLACES_URL=https://places.liketrek.com
